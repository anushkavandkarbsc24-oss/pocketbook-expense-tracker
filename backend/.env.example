# Copy this file to ".env" and fill in your own values.
PORT=5000
# Local MongoDB:
MONGO_URI=mongodb://127.0.0.1:27017/expense-tracker
# Or MongoDB Atlas (paste your own connection string):
# MONGO_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/expense-tracker
# Any long random string. Never commit the real one.
JWT_SECRET=change_this_to_a_long_random_string
# URL where the React app runs (used for CORS)
CLIENT_URL=http://localhost:5173
